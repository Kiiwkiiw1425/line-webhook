{
  "swagger": "2.0",
  "info": {
    "title": "Render Copilot API",
    "version": "1.0.0",
    "description": "API ให้ Copilot Studio Agent เรียกมายังเซิร์ฟเวอร์ Render ของคุณ"
  },
  "host": "https://line-webhook-test-ai.onrender.com",
  "basePath": "/",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "paths": {
    "/copilot": {
      "post": {
        "summary": "ส่งข้อความจาก Agent ไปยัง Render และรับคำตอบกลับ",
        "operationId": "postCopilot",
        "parameters": [
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": ["query"],
              "properties": {
                "query": {
                  "type": "string",
                  "description": "ข้อความที่ผู้ใช้ถาม (จาก Agent)"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "คำตอบสำเร็จ",
            "schema": {
              "type": "object",
              "required": ["answer"],
              "properties": {
                "answer": {
                  "type": "string",
                  "description": "ข้อความคำตอบสุดท้ายที่ Agent จะนำไปตอบผู้ใช้"
                }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "500": { "description": "Internal Server Error" }
        }
      }
    }
  }
}
